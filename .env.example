# ── 네이버 아이디로 로그인(네아로) ──────────────────────────────
# https://developers.naver.com/apps 에서 앱 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 앱에 등록한 콜백 URL과 반드시 글자 단위로 일치해야 함
# 로컬:  http://localhost:3000/api/auth/naver/callback
# 배포:  https://<your-app>.vercel.app/api/auth/naver/callback
NAVER_REDIRECT_URI=http://localhost:3000/api/auth/naver/callback

# ── 발행 대상 카페 (운영자 카페 1개 고정) ──────────────────────
# 카페 clubid (숫자). cafe.naver.com/moonblog 의 clubid
CAFE_CLUB_ID=31635811
# 발행할 게시판 menuid.
# 이 카페는 매달 새 챌린지 게시판을 만듭니다 (1월=2, 2월=4, ... 7월=16, 8월=19).
# 달이 바뀌면 이 값 하나만 바꾸면 회원 전원에게 반영됩니다.
# 주의: 상품게시판(18 상품 공유방)에는 카페 글쓰기 API로 글을 쓸 수 없습니다.
CAFE_MENU_ID=19

# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# service_role 키. 절대 클라이언트에 노출 금지 (서버 라우트에서만 사용)
SUPABASE_SERVICE_ROLE_KEY=

# ── Claude API ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── 보안 키 (아래 명령으로 생성) ────────────────────────────────
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 세션 쿠키 서명용
SESSION_SECRET=
# 네이버 토큰 암호화용 (AES-256-GCM, 32바이트 base64)
TOKEN_ENC_KEY=
# Vercel Cron 인증용 (Vercel이 Authorization: Bearer <CRON_SECRET> 으로 호출)
CRON_SECRET=

# ── 운영 옵션 ────────────────────────────────────────────────
# true 면 카페에 실제로 글을 쓰지 않고 로그만 남김 (API 승인 전 테스트용)
PUBLISH_DRY_RUN=true
# 회원 1명당 하루 최대 발행 건수
DAILY_LIMIT_PER_MEMBER=3
# 크론 1회 실행당 최대 발행 건수 (함수 실행시간 한도 대비)
MAX_PUBLISH_PER_RUN=8
# 발행 사이 대기 시간(ms). 네이버 카페 스팸 필터 회피용
PUBLISH_SPACING_MS=5000
